{
  "rules": {
    ".read": false,
    "loginDirectory": {
      ".read": true,
      "$username": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "publicShares": {
      "$username": {
        ".read": true,
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child($username).child('authUid').val() === auth.uid)"
      }
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$username": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child($username).child('authUid').val() === auth.uid)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (((data.child('authUid').val() === auth.uid) || (!data.child('authUid').exists() && newData.child('authUid').val() === auth.uid && newData.child('authEmail').val() === auth.token.email && (!data.child('authEmail').exists() || data.child('authEmail').val() === auth.token.email))) && (newData.child('isOwner').val() === data.child('isOwner').val() || (!data.child('isOwner').exists() && newData.child('isOwner').val() === false)) && (newData.child('isAdmin').val() === data.child('isAdmin').val() || (!data.child('isAdmin').exists() && newData.child('isAdmin').val() === false))))"
      }
    },
    "wishlist": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$username": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child($username).child('authUid').val() === auth.uid)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child($username).child('authUid').val() === auth.uid)"
      }
    },
    "dynamax": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$username": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child($username).child('authUid').val() === auth.uid)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child($username).child('authUid').val() === auth.uid)"
      }
    },
    "gmax": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$username": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child($username).child('authUid').val() === auth.uid)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child($username).child('authUid').val() === auth.uid)"
      }
    },
    "costumes": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$username": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child($username).child('authUid').val() === auth.uid)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child($username).child('authUid').val() === auth.uid)"
      }
    },
    "have": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$username": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child($username).child('authUid').val() === auth.uid)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || root.child('users').child($username).child('authUid').val() === auth.uid)"
      }
    },
    "offers": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$recipient": {
        "$offerId": {
          ".write": "auth != null && ((!data.exists() && newData.child('from').val() === root.child('authIndex').child(auth.uid).child('username').val()) || (data.exists() && data.child('from').val() === root.child('authIndex').child(auth.uid).child('username').val()) || $recipient === root.child('authIndex').child(auth.uid).child('username').val() || root.child('admins').child(auth.uid).val() === true)"
        }
      }
    },
    "trades": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$tradeId": {
        ".write": "auth != null && ((!data.exists() && newData.child('organizer').val() === root.child('authIndex').child(auth.uid).child('username').val()) || (data.exists() && data.child('organizer').val() === root.child('authIndex').child(auth.uid).child('username').val()) || (data.exists() && data.child('participants').child(root.child('authIndex').child(auth.uid).child('username').val()).exists()) || root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "requests": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".write": "!data.exists() || (auth != null && root.child('admins').child(auth.uid).val() === true)"
      }
    },
    "authIndex": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (root.child('admins').child(auth.uid).val() === true || (auth.uid === $uid && ((!data.exists() && newData.child('username').isString() && root.child('users').child(newData.child('username').val()).child('authUid').val() === auth.uid) || (data.exists() && newData.child('username').val() === data.child('username').val()))))"
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "communities": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$communityId": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "userCommunities": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        "$communityId": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
        }
      }
    },
    "communityRequests": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$communityId": {
        "$requestId": {
          ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
        }
      }
    },
    "pendingDecrements": {
      "$username": {
        ".read": "auth != null && (root.child('users').child($username).child('authUid').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)",
        "$decId": {
          ".write": "auth != null && ((!data.exists() && newData.child('from').val() === root.child('authIndex').child(auth.uid).child('username').val() && newData.child('qty').isNumber() && newData.child('qty').val() != 0 && newData.child('qty').val() >= -999 && newData.child('qty').val() <= 999 && newData.child('key').isString() && newData.child('key').val().length > 0) || (data.exists() && root.child('users').child($username).child('authUid').val() === auth.uid) || root.child('admins').child(auth.uid).val() === true)"
        }
      }
    },
    "trainerShares": {
      "$ownerUid": {
        ".read": true,
        ".write": "auth != null && auth.uid === $ownerUid",
        ".validate": "!newData.exists() || (newData.hasChildren(['schemaVersion', 'shareVersion', 'trainerName', 'profile', 'publishedListTypes', 'publishedAt', 'updatedAt']) && newData.child('schemaVersion').val() === 1 && newData.child('shareVersion').isNumber() && ((!data.exists() && newData.child('shareVersion').val() === 1) || (data.exists() && newData.child('shareVersion').val() === data.child('shareVersion').val() + 1)) && newData.child('trainerName').isString() && newData.child('trainerName').val().length > 0 && newData.child('trainerName').val().length <= 64 && (!data.exists() || newData.child('trainerName').val() === data.child('trainerName').val()) && newData.child('publishedAt').isNumber() && newData.child('publishedAt').val() > 0 && (!data.exists() || newData.child('publishedAt').val() === data.child('publishedAt').val()) && newData.child('updatedAt').isNumber() && newData.child('updatedAt').val() >= newData.child('publishedAt').val() && (!data.exists() || newData.child('updatedAt').val() > data.child('updatedAt').val()) && newData.child('updatedAt').val() <= now + 300000)",
        "profile": {
          ".validate": "newData.hasChildren(['friendCode', 'bio', 'discord', 'avatarPokemon', 'lastUpdated'])",
          "friendCode": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "bio": { ".validate": "newData.isString() && newData.val().length <= 120" },
          "discord": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "avatarPokemon": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "lastUpdated": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "$other": { ".validate": false }
        },
        "lists": {
          ".validate": "newData.hasChildren()",
          "$listType": {
            ".validate": "($listType === 'wishlist' || $listType === 'dynamax' || $listType === 'gmax' || $listType === 'costumes') && newData.hasChildren()",
            "$pokemonKey": {
              ".validate": "$pokemonKey.length > 0 && $pokemonKey.length <= 200 && $pokemonKey !== '__proto__' && $pokemonKey !== 'prototype' && $pokemonKey !== 'constructor' && ((newData.isString() && newData.val().length > 0 && newData.val().length <= 512) || newData.hasChildren(['p']))",
              "p": { ".validate": "newData.val() === 'H' || newData.val() === 'M' || newData.val() === 'L'" },
              "mod": { ".validate": "newData.isString() && newData.val().length <= 200" },
              "lucky": { ".validate": "newData.isBoolean()" },
              "shiny": { ".validate": "newData.isBoolean()" },
              "xxl": { ".validate": "newData.isBoolean()" },
              "xxs": { ".validate": "newData.isBoolean()" },
              "backgroundId": { ".validate": "newData.isString() && (newData.val() === '' || newData.val().matches(/^[a-z0-9]+(?:-[a-z0-9]+)*$/)) && newData.val().length <= 120" },
              "$other": { ".validate": false }
            }
          }
        },
        "publishedListTypes": {
          ".validate": "newData.hasChildren(['wishlist', 'dynamax', 'gmax', 'costumes'])",
          "$listType": {
            ".validate": "($listType === 'wishlist' || $listType === 'dynamax' || $listType === 'gmax' || $listType === 'costumes') && newData.val() === true"
          }
        },
        "$other": {
          ".validate": "$other === 'schemaVersion' || $other === 'shareVersion' || $other === 'trainerName' || $other === 'publishedAt' || $other === 'updatedAt'"
        }
      }
    },
    "_ping": {
      ".write": "auth != null"
    }
  }
}
