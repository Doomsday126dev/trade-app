{
  "rules": {
    ".read": false,
    ".write": false,
    "authIndex": {
      "$uid": {
        "username": {
          ".read": "auth != null && auth.uid === $uid"
        }
      }
    },
    "users": {
      "$username": {
        "authUid": {
          ".read": "auth != null && data.val() === auth.uid"
        }
      }
    },
    "loginDirectory": {
      "$username": {
        ".read": "auth != null && root.child('users').child($username).child('authUid').val() === auth.uid"
      }
    }
  }
}
