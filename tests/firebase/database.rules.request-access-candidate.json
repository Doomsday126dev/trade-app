{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": false,
        ".write": false
      }
    },
    "requests": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".write": "(!data.exists() && auth == null && newData.exists()) || (data.exists() && auth != null && root.child('admins').child(auth.uid).val() === true)",
        ".validate": "$id.matches(/^req_[0-9]+_[a-z0-9]{1,5}$/) && newData.hasChildren(['username','note','requestedAt','status']) && ((!data.exists() && newData.child('status').val() === 'pending') || (data.exists() && newData.child('username').val() === data.child('username').val() && newData.child('note').val() === data.child('note').val() && newData.child('requestedAt').val() === data.child('requestedAt').val() && data.child('status').val() === 'pending' && (newData.child('status').val() === 'approved' || newData.child('status').val() === 'denied')))",
        "username": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 32 && newData.val().matches(/^[^ ].*[^ ]$/) && !newData.val().contains('\\u0000') && !newData.val().contains('\\u0001') && !newData.val().contains('\\u0002') && !newData.val().contains('\\u0003') && !newData.val().contains('\\u0004') && !newData.val().contains('\\u0005') && !newData.val().contains('\\u0006') && !newData.val().contains('\\u0007') && !newData.val().contains('\\u0008') && !newData.val().contains('\\u0009') && !newData.val().contains('\\u000A') && !newData.val().contains('\\u000B') && !newData.val().contains('\\u000C') && !newData.val().contains('\\u000D') && !newData.val().contains('\\u000E') && !newData.val().contains('\\u000F') && !newData.val().contains('\\u0010') && !newData.val().contains('\\u0011') && !newData.val().contains('\\u0012') && !newData.val().contains('\\u0013') && !newData.val().contains('\\u0014') && !newData.val().contains('\\u0015') && !newData.val().contains('\\u0016') && !newData.val().contains('\\u0017') && !newData.val().contains('\\u0018') && !newData.val().contains('\\u0019') && !newData.val().contains('\\u001A') && !newData.val().contains('\\u001B') && !newData.val().contains('\\u001C') && !newData.val().contains('\\u001D') && !newData.val().contains('\\u001E') && !newData.val().contains('\\u001F') && !newData.val().contains('\\u007F')"
        },
        "note": {
          ".validate": "newData.isString() && newData.val().length <= 280 && (newData.val() === '' || newData.val().matches(/^[^ ]$/) || newData.val().matches(/^[^ ].*[^ ]$/)) && !newData.val().contains('\\u0000') && !newData.val().contains('\\u0001') && !newData.val().contains('\\u0002') && !newData.val().contains('\\u0003') && !newData.val().contains('\\u0004') && !newData.val().contains('\\u0005') && !newData.val().contains('\\u0006') && !newData.val().contains('\\u0007') && !newData.val().contains('\\u0008') && !newData.val().contains('\\u0009') && !newData.val().contains('\\u000A') && !newData.val().contains('\\u000B') && !newData.val().contains('\\u000C') && !newData.val().contains('\\u000D') && !newData.val().contains('\\u000E') && !newData.val().contains('\\u000F') && !newData.val().contains('\\u0010') && !newData.val().contains('\\u0011') && !newData.val().contains('\\u0012') && !newData.val().contains('\\u0013') && !newData.val().contains('\\u0014') && !newData.val().contains('\\u0015') && !newData.val().contains('\\u0016') && !newData.val().contains('\\u0017') && !newData.val().contains('\\u0018') && !newData.val().contains('\\u0019') && !newData.val().contains('\\u001A') && !newData.val().contains('\\u001B') && !newData.val().contains('\\u001C') && !newData.val().contains('\\u001D') && !newData.val().contains('\\u001E') && !newData.val().contains('\\u001F') && !newData.val().contains('\\u007F')"
        },
        "requestedAt": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() % 1 === 0"
        },
        "status": {
          ".validate": "newData.isString()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
